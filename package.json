{
  "name": "prysight",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:database": "tsx scripts/check-database.ts",
    "check:production-contract": "node scripts/validate-production-contract.mjs",
    "postinstall": "prisma generate",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.20.3",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.2",
    "next": "16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "node-fetch": "^3.3.2",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.5",
    "recharts": "^3.10.1",
    "stripe": "^22.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
